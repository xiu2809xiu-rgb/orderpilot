# OrderPilot environment. Copy this file to .env at the repository root:
#
#   cp .env.example .env        (macOS, Linux, Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# One root .env is enough. The API reads apps/api/.env first, then this file,
# and never overrides a variable that the shell, CI or Docker already set. A
# missing file is skipped. Values may refer to each other with ${NAME}.
#
# Every value below is a safe default for a laptop. Nothing here is a secret:
# keys for AI providers go in this file only on your own machine, and .env is
# never committed (the pre-commit hooks check).

# --- Where the API runs ------------------------------------------------------

# local, demo or production. REQUIRED, and kept apart from NODE_ENV: safety
# rules key off this. A demo stack runs NODE_ENV=production with APP_ENV=demo.
# production refuses DEMO_MODE=true and http:// origins.
APP_ENV=local

# development, test or production. Libraries read this one.
NODE_ENV=development

# Turns on the sign-in by persona (POST /api/v1/auth/demo-login): one button
# per role, no password. True here so a local run shows the nine role buttons.
# Off, the route does not exist. APP_ENV=production refuses it (the API will not
# start). The API's own default, when the variable is missing, is false.
DEMO_MODE=true

# --- HTTP --------------------------------------------------------------------

# 127.0.0.1 keeps the API on this machine. Containers set 0.0.0.0 themselves.
API_HOST=127.0.0.1
API_PORT=3000

# The port Vite serves the web app on (dev and preview). The Vite dev server and
# preview proxy /api to API_PORT above, and read only these two names.
WEB_PORT=5173

# How many reverse proxies (Caddy, nginx) sit in front of the API. Rate limits
# and logs use the client address this many hops in. 0 means none.
TRUST_PROXY_HOPS=0

# The origins a browser may call the API from, separated by commas. Each is
# scheme://host[:port] with no path. It follows WEB_PORT, so one line moves both.
CORS_ORIGINS=http://localhost:${WEB_PORT}

# --- Rate limiting -----------------------------------------------------------

# At most this many requests per client in each window. The health probes are
# not counted.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --- Sign-in and sessions ----------------------------------------------------

# Signs the access token (HS256). At least 32 characters. This value is public,
# so every APP_ENV except local refuses it: generate your own there, for example with
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=local-development-secret-not-for-production-use

# How long the access token and the refresh token last, in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookies carry the Secure flag. false lets plain http://localhost work in every
# browser (Safari ignores a Secure cookie on http). Only APP_ENV=local may set
# it to false; the API refuses to start with it off anywhere else.
COOKIE_SECURE=false

# Sign-in attempts allowed per client in each rate-limit window. Stricter than
# RATE_LIMIT_MAX_REQUESTS above.
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# The password of the nine seeded accounts (pnpm db:seed), for password
# sign-in on a laptop or a demo, for example system.admin@example.test. Not a
# secret: never use it where real data lives. APP_ENV=production refuses it.
DEMO_PASSWORD=orderpilot-demo-password

# --- Logging and docs --------------------------------------------------------

# fatal, error, warn, info, debug, trace or silent. One JSON line per request.
LOG_LEVEL=info

# Swagger UI at /api/docs. On by default, off when APP_ENV=production unless
# set here. Uncomment to decide for yourself.
# SWAGGER_ENABLED=true

# --- The local stack (docker-compose.yml) -----------------------------------

# Host ports for PostgreSQL, Redis, MinIO and Mailpit. Change one line here and every URL
# below moves with it. Port taken already? Pick another and run
# docker compose up -d --wait again.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
# MinIO's browser console.
MINIO_CONSOLE_PORT=9001
# Mailpit catches all email. It is the only place OrderPilot sends email in
# development and demos: nothing leaves your machine. Read the messages at
# http://127.0.0.1:${MAILPIT_UI_PORT}.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Local passwords for a laptop. Nothing in them is a secret: the ports are bound
# to 127.0.0.1 only. Never reuse these anywhere else.
POSTGRES_USER=orderpilot
POSTGRES_PASSWORD=orderpilot
POSTGRES_DB=orderpilot
MINIO_ROOT_USER=orderpilot
MINIO_ROOT_PASSWORD=orderpilot-minio-secret

# Optional observability stack (docker compose --profile observability up -d
# otel-lgtm). Grafana is on GRAFANA_PORT (never 3000, which the API may use);
# the API sends OTLP/HTTP to OTLP_HTTP_PORT.
GRAFANA_PORT=3300
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Database ----------------------------------------------------------------

# PostgreSQL, built from the lines above. REQUIRED. 127.0.0.1 rather than
# localhost, because some machines try IPv6 first and nothing listens there.
# Commands: pnpm db:migrate (apply migrations), pnpm db:seed (idempotent),
# pnpm db:generate (rebuild the Prisma client), pnpm db:migrate:dev (create a
# migration after editing apps/api/prisma/schema).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis and queues --------------------------------------------------------

# REQUIRED. The database number (the /0 at the end) is how the tests keep to
# themselves: they use TEST_REDIS_DB and flush only that one.
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/${REDIS_DB}

# --- Document storage (S3 API) ----------------------------------------------

# MinIO here, AWS S3 later: delete S3_ENDPOINT and S3_FORCE_PATH_STYLE, and set
# the region, keys and bucket.
S3_ENDPOINT=http://127.0.0.1:${MINIO_PORT}
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=orderpilot-documents
S3_FORCE_PATH_STYLE=true
# Create the bucket at start-up when it is missing. Turn off where the bucket
# is made by hand or by infrastructure code (production).
S3_CREATE_BUCKET=true

# --- Tests (pnpm test) -------------------------------------------------------

# The integration tests run against their own database, Redis database number
# and bucket, never your development data. Names come from variables so that
# parallel worktrees can share one PostgreSQL: give each its own here.
# The tests refuse to touch a database named like the development one.
TEST_POSTGRES_DB=orderpilot_test
TEST_REDIS_DB=1
TEST_S3_BUCKET=orderpilot-test
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${TEST_POSTGRES_DB}
TEST_REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/${TEST_REDIS_DB}

# Outgoing email goes to Mailpit (docker-compose.yml), with no login or TLS. The
# sender that reads these arrives with the first story that sends a message.
SMTP_HOST=127.0.0.1
SMTP_PORT=${MAILPIT_SMTP_PORT}
SMTP_FROM=OrderPilot <orderpilot@example.test>

# Set by the image build (P-13). Shown by /health.
# GIT_SHA=

# --- Monitoring (ADRs 0021, 0022 and 0028) ----------------------------------

# Each is off unless set. Traces and metrics are always made inside the API so
# that a log line carries its trace id; they leave it only with the address.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:${OTLP_HTTP_PORT}

# GET /metrics answers only to this bearer token (at least 24 characters), and
# not at all without it. Generate one, for example with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# METRICS_TOKEN=

# Errors from the API go to Sentry only when this is set; the web app uses
# VITE_SENTRY_DSN in apps/web/.env.local the same way. Cookies, auth headers
# and request bodies are scrubbed first.
# SENTRY_DSN=

