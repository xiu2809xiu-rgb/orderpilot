# OrderPilot configuration. Copy to .env and change what you need:
#   cp .env.example .env
# Every variable has a safe default, so a missing .env still starts the stack.
# Keys and passwords never go in this file. The real .env is git-ignored.

# --- Web app (apps/web) ---
# The port Vite serves the web app on (dev and preview).
WEB_PORT=5173
# The port of the API. The Vite dev server and preview proxy /api to it.
API_PORT=3000
