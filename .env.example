# OrderPilot environment. Copy this file to .env at the repository root:
#
#   cp .env.example .env        (macOS, Linux, Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# One root .env is enough. The API reads apps/api/.env first, then this file,
# and never overrides a variable that the shell, CI or Docker already set. A
# missing file is skipped. Values may refer to each other with ${NAME}.
#
# Every value below is a safe default for a laptop. Nothing here is a secret:
# keys for AI providers go in this file only on your own machine, and .env is
# never committed (the pre-commit hooks check).

# --- Where the API runs ------------------------------------------------------

# local, demo or production. REQUIRED, and kept apart from NODE_ENV: safety
# rules key off this. A demo stack runs NODE_ENV=production with APP_ENV=demo.
# production refuses DEMO_MODE=true and http:// origins.
APP_ENV=local

# development, test or production. Libraries read this one.
NODE_ENV=development

# Seeds the demo accounts and the sign-in by persona (from P-10). Never true
# with APP_ENV=production.
DEMO_MODE=false

# --- HTTP --------------------------------------------------------------------

# 127.0.0.1 keeps the API on this machine. Containers set 0.0.0.0 themselves.
API_HOST=127.0.0.1
API_PORT=3000

# How many reverse proxies (Caddy, nginx) sit in front of the API. Rate limits
# and logs use the client address this many hops in. 0 means none.
TRUST_PROXY_HOPS=0

# The origins a browser may call the API from, separated by commas. Each is
# scheme://host[:port] with no path. The web app's dev server is 5173.
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting -----------------------------------------------------------

# At most this many requests per client in each window. The health probes are
# not counted.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --- Logging and docs --------------------------------------------------------

# fatal, error, warn, info, debug, trace or silent. One JSON line per request.
LOG_LEVEL=info

# Swagger UI at /api/docs. On by default, off when APP_ENV=production unless
# set here. Uncomment to decide for yourself.
# SWAGGER_ENABLED=true

# Set by the image build (P-13). Shown by /health.
# GIT_SHA=
