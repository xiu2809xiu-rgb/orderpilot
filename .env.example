# OrderPilot environment. Copy this file to .env at the repository root:
#
#   cp .env.example .env        (macOS, Linux, Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# One root .env is enough. The API reads apps/api/.env first, then this file,
# and never overrides a variable that the shell, CI or Docker already set. A
# missing file is skipped. Values may refer to each other with ${NAME}.
#
# Every value below is a safe default for a laptop. Nothing here is a secret:
# keys for AI providers go in this file only on your own machine, and .env is
# never committed (the pre-commit hooks check).

# --- Where the API runs ------------------------------------------------------

# local, demo or production. REQUIRED, and kept apart from NODE_ENV: safety
# rules key off this. A demo stack runs NODE_ENV=production with APP_ENV=demo.
# production refuses DEMO_MODE=true and http:// origins.
APP_ENV=local

# development, test or production. Libraries read this one.
NODE_ENV=development

# Turns on the sign-in by persona (POST /api/v1/auth/demo-login): one button
# per role, no password. True here so a local run shows the nine role buttons.
# Off, the route does not exist. APP_ENV=production refuses it (the API will not
# start). The API's own default, when the variable is missing, is false.
DEMO_MODE=true

# Puts the proposal demo's storyline into the generated sample data: the order
# short of stock becomes PO 4471-26 from customer C-1042 (1,000 SSDs at USD 61.20),
# and the order with the PI price mismatch gets the same item. False here, so the
# sample data and its tests stay as generated. Read once at start-up by the API,
# the worker and the seed. Set it before `pnpm db:seed`, which stores its tasks.
DEMO_STORYLINE=false

# Brings back the menu entries and pages of screens that are not built yet, so
# the team can see what is coming. Development server only (pnpm dev): a build,
# a preview and the tests ignore it. Off by default, so screenshots match production.
VITE_SHOW_PLANNED=false

# --- HTTP --------------------------------------------------------------------

# 127.0.0.1 keeps the API on this machine. Containers set 0.0.0.0 themselves.
API_HOST=127.0.0.1
API_PORT=3000

# The port Vite serves the web app on (dev and preview). The Vite dev server and
# preview proxy /api to API_PORT above, and read only these two names.
WEB_PORT=5173

# How many reverse proxies (Caddy, nginx) sit in front of the API. Rate limits
# and logs use the client address this many hops in. 0 means none.
TRUST_PROXY_HOPS=0

# The origins a browser may call the API from, separated by commas. Each is
# scheme://host[:port] with no path. It follows WEB_PORT, so one line moves both.
CORS_ORIGINS=http://localhost:${WEB_PORT}

# --- Rate limiting -----------------------------------------------------------

# At most this many requests per client in each window. The health probes are
# not counted.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --- Sign-in and sessions ----------------------------------------------------

# Signs the access token (HS256). At least 32 characters. This value is public,
# so every APP_ENV except local refuses it: generate your own there, for example with
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=local-development-secret-not-for-production-use

# Keys the fingerprints of vendors' bank details, so that no account number is
# ever stored (F-5). At least 32 characters. This value is public, so every
# APP_ENV except local refuses it: generate your own there, as for JWT_SECRET,
# and set it once, because a new key makes every vendor's details look changed.
# Without one, comparing bank details fails closed.
BANK_FINGERPRINT_KEY=local-development-bank-fingerprint-key-not-for-production-use

# Temporary (ADR 0056): "on" lets any one of the approver group decide an
# approval (#252). "off" keeps today's approval chain, its substitutes and its
# limits unchanged, until area 2 routes with the group (#251) and turns it on.
APPROVER_GROUP=off

# The approver group's approval limits (ADR 0056), counted only while
# APPROVER_GROUP is on: off, so any one approver decides any amount, until
# Spectra confirms its limits. "on" applies each approver's limit from their
# approval setup. Any other value is refused.
APPROVAL_LIMITS=off

# How long the access token and the refresh token last, in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookies carry the Secure flag. false lets plain http://localhost work in every
# browser (Safari ignores a Secure cookie on http). Only APP_ENV=local may set
# it to false; the API refuses to start with it off anywhere else.
COOKIE_SECURE=false

# Sign-in attempts allowed per client in each rate-limit window. Stricter than
# RATE_LIMIT_MAX_REQUESTS above. `pnpm e2e` signs in as every role at once:
# for repeated runs set 1000 here and restart the stack, as CI does.
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# The password of the nine seeded accounts (pnpm db:seed), for password
# sign-in on a laptop or a demo, for example system.admin@example.test. Not a
# secret: never use it where real data lives. APP_ENV=production refuses it.
DEMO_PASSWORD=orderpilot-demo-password

# --- Logging and docs --------------------------------------------------------

# fatal, error, warn, info, debug, trace or silent. One JSON line per request.
LOG_LEVEL=info

# Swagger UI at /api/docs. On by default, off when APP_ENV=production unless
# set here. Uncomment to decide for yourself.
# SWAGGER_ENABLED=true

# --- The local stack (docker-compose.yml) -----------------------------------

# Host ports for PostgreSQL, Redis, MinIO and Mailpit. Change one line here and every URL
# below moves with it. Port taken already? Pick another and run
# docker compose up -d --wait again.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
# MinIO's browser console.
MINIO_CONSOLE_PORT=9001
# Mailpit catches all email. It is the only place OrderPilot sends email in
# development and demos: nothing leaves your machine. Read the messages at
# http://127.0.0.1:${MAILPIT_UI_PORT}.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Where `docker compose up --build` serves the app: http://localhost:8080. Not
# WEB_PORT, so the full stack and `pnpm dev` can run side by side. The API has no
# host port in that stack: the web container proxies /api to it.
STACK_WEB_PORT=8080
# The same for the throwaway stack of docker-compose.samples.yml.
SAMPLES_WEB_PORT=8081

# Local passwords for a laptop. Nothing in them is a secret: the ports are bound
# to 127.0.0.1 only. Never reuse these anywhere else.
POSTGRES_USER=orderpilot
POSTGRES_PASSWORD=orderpilot
POSTGRES_DB=orderpilot
MINIO_ROOT_USER=orderpilot
MINIO_ROOT_PASSWORD=orderpilot-minio-secret

# Optional observability stack (docker compose --profile observability up -d
# otel-lgtm). Grafana is on GRAFANA_PORT (never 3000, which the API may use);
# the API sends OTLP/HTTP to OTLP_HTTP_PORT.
GRAFANA_PORT=3300
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Database ----------------------------------------------------------------

# PostgreSQL, built from the lines above. REQUIRED. 127.0.0.1 rather than
# localhost, because some machines try IPv6 first and nothing listens there.
# Commands: pnpm db:migrate (apply migrations), pnpm db:seed (idempotent),
# pnpm db:generate (rebuild the Prisma client), pnpm db:migrate:dev (create a
# migration after editing apps/api/prisma/schema).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis and queues --------------------------------------------------------

# REQUIRED. The database number (the /0 at the end) is how the tests keep to
# themselves: they use TEST_REDIS_DB and flush only that one.
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/${REDIS_DB}

# Optional. How often, in seconds, the API sends workflow reminders and
# escalations that have come due. 0 switches it off. The default is 60.
WORKFLOW_SWEEP_SECONDS=60

# Whether a sales order waits for a management approver before its PI goes out
# (#251, point 9). Spectra has no sales approval today (A-19), so it is off.
# "on" turns it on; any other value is refused.
SALES_APPROVAL=off

# --- Document storage (S3 API) ----------------------------------------------

# MinIO here, AWS S3 later: delete S3_ENDPOINT and S3_FORCE_PATH_STYLE, and set
# the region, keys and bucket.
S3_ENDPOINT=http://127.0.0.1:${MINIO_PORT}
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=orderpilot-documents
S3_FORCE_PATH_STYLE=true
# Create the bucket at start-up when it is missing. Turn off where the bucket
# is made by hand or by infrastructure code (production).
S3_CREATE_BUCKET=true

# --- Tests (pnpm test) -------------------------------------------------------

# The integration tests run against their own database, Redis database number
# and bucket, never your development data. Names come from variables so that
# parallel worktrees can share one PostgreSQL: give each its own here.
# The tests refuse to touch a database named like the development one.
TEST_POSTGRES_DB=orderpilot_test
TEST_REDIS_DB=1
TEST_S3_BUCKET=orderpilot-test
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${TEST_POSTGRES_DB}
TEST_REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/${TEST_REDIS_DB}

# Outgoing email goes to Mailpit (docker-compose.yml), with no login or TLS. The
# sender that reads these arrives with the first story that sends a message.
SMTP_HOST=127.0.0.1
SMTP_PORT=${MAILPIT_SMTP_PORT}
SMTP_FROM=OrderPilot <orderpilot@example.test>

# Set by the image build (pass it to `docker compose build`). Shown by /health.
# GIT_SHA=

# --- Monitoring (ADRs 0021, 0022 and 0028) ----------------------------------

# Each is off unless set. Traces and metrics are always made inside the API so
# that a log line carries its trace id; they leave it only with the address.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:${OTLP_HTTP_PORT}

# GET /metrics answers only to this bearer token (at least 24 characters), and
# not at all without it. Generate one, for example with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# METRICS_TOKEN=

# Errors from the API go to Sentry only when this is set; the web app uses
# VITE_SENTRY_DSN in apps/web/.env.local the same way. Cookies, auth headers
# and request bodies are scrubbed first.
# SENTRY_DSN=


# --- The AI gateway (P-17) -----------------------------------------------------

# Which model provider the API uses: mock, gemini, groq, openai-compatible or
# bedrock. The default, mock, is offline: it plays fixed scripts, needs no key
# and sends nothing anywhere. Leave it as it is unless you are trying a real one.
# ONLY SYNTHETIC DATA MAY BE SENT to a real provider (the data-to-AI policy
# refuses the rest), and a free-tier provider may keep and use what it is sent.
# Never put a customer's or Spectra's document through one.
# After changing it, check it with the probe (POST /api/v1/ai/probe, System admin)
# instead of reading this file: the probe says what happened and never a key.
AI_PROVIDER=mock

# Real keys go in your own root .env, never in this file and never in Git. A key
# is needed only for the provider you choose. Leave these commented here.
# The easy way: run pnpm ai:key. It asks for the provider (gemini or groq), the
# key (nothing shows as you type) and the model id, then sets AI_PROVIDER, the
# key's variable and AI_MODEL in your root .env and keeps every other line. It
# never prints the key and sends nothing anywhere. Restart the API afterwards.
# GEMINI_API_KEY=
# GROQ_API_KEY=

# openai-compatible only (OpenRouter, NVIDIA NIM, a local Ollama and the like):
# the address up to and including its version path, and a key if it wants one.
# With APP_ENV=production the address must be https, except one on this machine.
# gemini and groq know their own addresses, so these are not read for them.
# AI_BASE_URL=
# AI_API_KEY=

# The model ids. REQUIRED for every provider except mock, and deliberately with
# no default: ids are retired and renamed faster than this file is updated. The
# vision model reads page images and falls back to AI_MODEL when it is not set.
# AI_MODEL=
# AI_VISION_MODEL=

# How a provider is asked for JSON: json_schema (strict, the default),
# json_object, or prompt (plain instructions, for a server that supports neither).
# The answer is checked against its schema either way.
# AI_STRUCTURED_OUTPUT=json_schema

# Limits, shown at their defaults. The timeout is in milliseconds: for a plain
# request it is the time to the whole answer, and for a streamed one it is the
# longest silence (to the first part, and between one part and the next), so a
# long answer that keeps arriving is never cut. A timeout is not tried again.
# Attempts count the first try, and the limit applies twice: it caps the tries
# of one provider request, and, separately, the rounds of asking again for an
# answer that does not fit its schema. Tool steps cap one call's tool loop.
# AI_TIMEOUT_MS=60000
# AI_MAX_ATTEMPTS=3
# AI_MAX_TOOL_STEPS=5
# AI_MAX_IMAGES_PER_REQUEST=3
# AI_MAX_OUTPUT_TOKENS=4096

# What a million tokens cost in USD, to estimate the cost of each call. The
# default is 0, so a free tier shows $0.0000. Take the prices from your
# provider; they are not in the code because they change.
# AI_PRICE_INPUT_USD_PER_MTOK=0
# AI_PRICE_OUTPUT_USD_PER_MTOK=0

# bedrock only. The API reads no credentials from anywhere else, so all three
# of region, key id and secret are required. The session token is for
# temporary credentials.
# AI_BEDROCK_REGION=
# AI_BEDROCK_ACCESS_KEY_ID=
# AI_BEDROCK_SECRET_ACCESS_KEY=
# AI_BEDROCK_SESSION_TOKEN=


# --- Spark (P-95) --------------------------------------------------------------

# What the data stored in this deployment is: synthetic (the default) or real.
# Spark tells the AI destination check where its data came from by this line, so
# it must be true. Only "synthetic" lets a question and its answers reach a
# provider. With "real", Spark is refused for every provider, the offline mock
# included, until area 4 adds a rule: the default policy trusts no provider with
# real data. Unset or blank counts as synthetic, except when APP_ENV=production,
# which refuses to start without it: say it there, one way or the other. Any word
# other than "synthetic" or "real" stops the API from starting, and only inside
# Spark does a value it cannot read count as real. The Docker stack passes this
# line in as it is, and the client-samples stack always says "real".
DATA_ORIGIN=synthetic

# How many questions Spark takes in a minute and in a day, shown at their
# defaults. A real provider is paid by the token, so these bound the cost.
# A question over either limit is refused with RATE_LIMITED. The per-minute limit
# is kept per caller address and counts refused calls too. The daily cap is kept
# per user, so in a demo the testers of one role share it.
# SPARK_QUESTIONS_PER_MINUTE=6
# SPARK_QUESTIONS_PER_DAY=100
