// Area 1 models: documents and the AI pipeline. Owner: Richie.
//
// G-1 (area 4) added AiUsageRecord here, additively, because its AI usage and
// cost screen reads it. The gateway (P-17) writes it, one row per gateway call.

/// One gateway call: what was asked for, what it cost, how long it took. The
/// first thirteen fields follow aiUsageSchema in @orderpilot/shared, which area
/// 4's screen reads. documentId, origin, classification, attempts and
/// reasonCode are the gateway's own, added by P-17. Metadata only: a prompt,
/// a document or an answer is never stored here.
model AiUsageRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  occurredAt     DateTime @db.Timestamptz(3)
  /// The product feature that asked, such as "document-extraction".
  feature        String
  /// The setting's name (mock, gemini, groq, openai-compatible, bedrock).
  provider       String
  model          String
  promptVersion  String
  inputTokens    Int
  outputTokens   Int
  /// USD, four places like every amount in the app. An estimate: tokens times
  /// the configured prices.
  costUsd        Decimal  @db.Decimal(14, 4)
  latencyMs      Int
  /// ok, error, refused or timeout.
  status         String
  /// The person on whose action the call ran. Null for a background job.
  userId         String?  @db.Uuid
  traceId        String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  /// The document the call read, as text with no foreign key: P-18 owns
  /// documents, and a usage record must outlive a deleted one.
  documentId     String?
  /// What the destination check was asked: where the data came from (synthetic
  /// or real) and how it is classified.
  origin         String?
  classification String?
  /// Provider requests made for this call (a retry after invalid output adds
  /// one). Tokens and latency cover all of them.
  attempts       Int      @default(1)
  /// A short code for an outcome that is not ok, such as a policy rule id,
  /// provider-http-429 or invalid-output. Never a message.
  reasonCode     String?

  @@index([occurredAt])
  @@index([feature])
  @@index([documentId])
  /// Spark joins an answer to its usage record by this id (P-95).
  @@index([traceId])
}

/// Who wrote a Spark message.
enum SparkMessageRole {
  USER
  ASSISTANT
}

/// How an answer ended. A question has no status of its own: a question with
/// no answer after it is the one pending.
enum SparkMessageStatus {
  OK
  FAILED
  STOPPED
}

/// A person's thread with Spark (P-95). It belongs to one person; in a demo
/// session, where everyone of a role signs in as one user, it also belongs to
/// that session, so nobody reads another tester's questions. Archived, never
/// deleted: the stored text can be compared with the hash in the audit trail.
model SparkConversation {
  id         String         @id @default(uuid(7)) @db.Uuid
  /// The person, as a plain id: no relation into another area's table.
  userId     String         @db.Uuid
  /// The sign-in session of a demo sign-in. Null for a real one.
  sessionId  String?
  /// Null until the first question gives it one.
  title      String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @default(now()) @db.Timestamptz(3)
  archivedAt DateTime?      @db.Timestamptz(3)
  messages   SparkMessage[]

  @@index([userId, updatedAt])
}

/// One turn of a conversation. Written once and never updated, so a stored
/// answer is what was audited.
model SparkMessage {
  id             String             @id @default(uuid(7)) @db.Uuid
  conversationId String             @db.Uuid
  conversation   SparkConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 ... within the conversation. The unique key below is what lets
  /// only one of two questions that arrive together be stored.
  seq            Int
  role           SparkMessageRole
  /// OK for a question.
  status         SparkMessageStatus @default(OK)
  content        String
  /// What the tools looked at, built by the server from their results, as JSON.
  sources        Json               @default("[]")
  /// The tools that ran or were refused, as JSON.
  steps          Json               @default("[]")
  /// The role the person held when the message was written. A role's rights can
  /// change after an answer was stored.
  actorRole      String
  /// The AI_PROVIDER setting and the model that answered. Null on a question
  /// and on an answer no provider gave.
  provider       String?
  model          String?
  mock           Boolean?
  /// Null when the call failed before it reported any.
  inputTokens    Int?
  outputTokens   Int?
  finishReason   String?
  /// A short code for a failed or stopped answer, never a message.
  errorCode      String?
  /// The trace id of the gateway call, which is also the usage record's: the
  /// request id and this message's id, so a caller cannot reuse another's.
  traceId        String
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([conversationId, seq])
}
