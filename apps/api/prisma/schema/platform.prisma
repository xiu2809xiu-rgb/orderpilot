// Platform models: users, sessions, the role-permission matrix and the audit
// trail. Owner: Richie (platform). Area 4 owns the matrix contents.
//
// Conventions for every area's file:
// - Primary keys are UUID v7, so they sort by creation time.
// - Money and quantities are Decimal, never Float. (None here yet.)
// - Timestamps are timestamptz with millisecond precision.

enum Role {
  SYSTEM_ADMIN
  PRODUCT_MANAGER
  APPROVER
  SUPPORT
  WAREHOUSE
  FINANCE
  LOGISTICS
  MANAGEMENT
  AUDITOR
}

/// A person who signs in. Users are disabled, never deleted: the audit trail
/// and every record they touched keep pointing at them.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  displayName  String
  /// An argon2 hash (P-10). Null for a demo account that signs in by persona.
  passwordHash String?
  role         Role
  /// Set when the user is disabled. A disabled user cannot sign in, and every
  /// refresh token of theirs is revoked.
  disabledAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens   RefreshToken[]
  profilePictures ProfilePicture[]

  @@index([role])
}

/// One refresh token. Tokens of one sign-in share a family. Each use rotates the
/// token: the old one gets usedAt and a successor. Presenting a token that was
/// used already means it was stolen, so the whole family is revoked.
model RefreshToken {
  id                String    @id @default(uuid(7)) @db.Uuid
  familyId          String    @db.Uuid
  userId            String    @db.Uuid
  /// SHA-256 of the token. The token itself is never stored.
  tokenHash         String    @unique
  expiresAt         DateTime  @db.Timestamptz(3)
  /// Set when this token was exchanged for the next one.
  usedAt            DateTime? @db.Timestamptz(3)
  replacedByTokenId String?   @unique @db.Uuid
  /// Set when the token, or its whole family, is no longer valid.
  revokedAt         DateTime? @db.Timestamptz(3)
  /// Why: "logout", "reuse-detected", "user-disabled", "password-changed".
  revokedReason     String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  ip                String?
  userAgent         String?
  /// True when the sign-in was the demo sign-in, so a refresh keeps saying so.
  demo              Boolean   @default(false)

  user       User          @relation(fields: [userId], references: [id])
  replacedBy RefreshToken? @relation("Rotation", fields: [replacedByTokenId], references: [id])
  replaces   RefreshToken? @relation("Rotation")

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
}

enum ProfilePictureStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

/// Why a REMOVED picture ended. Null in every other status.
enum ProfilePictureRemoval {
  WITHDRAWN
  REPLACED_BY_UPLOAD
  REPLACED_BY_APPROVAL
  TAKEN_DOWN
}

/// What became of the AI check. CHECKED: a real model answered. NOT_ALLOWED:
/// the data rule refused, nothing was sent. NOT_RUN: allowed but no usable
/// answer came (timeout, failure, or only the mock answered).
enum ProfilePictureAiStatus {
  CHECKED
  NOT_ALLOWED
  NOT_RUN
}

enum ProfilePictureAiVerdict {
  LOOKS_FINE
  NEEDS_A_CLOSER_LOOK
}

/// One profile picture a person sent. A row is kept for ever (who, when, why
/// and the hash); the picture itself is kept only while it is PENDING or
/// APPROVED. A person has at most one PENDING and one APPROVED row, held by two
/// partial unique indexes in the migration.
model ProfilePicture {
  id              String                   @id @default(uuid(7)) @db.Uuid
  userId          String                   @db.Uuid
  status          ProfilePictureStatus     @default(PENDING)
  /// Set when status is REMOVED, and only then.
  removal         ProfilePictureRemoval?
  /// Where the cleaned JPEG is stored: profile-pictures/<userId>/<random uuid>.jpg
  objectKey       String                   @unique
  /// Set when the stored object has been deleted. A REJECTED or REMOVED row
  /// with this still null is waiting for the sweep.
  objectDeletedAt DateTime?                @db.Timestamptz(3)
  /// Size of the cleaned file, not of what was received.
  byteSize        Int
  /// SHA-256 of the cleaned file, 64 lower case hex characters. It is also the ETag.
  sha256          String
  /// Pixels on each side (the picture is square).
  width           Int
  progressive     Boolean
  aiStatus        ProfilePictureAiStatus
  /// The policy rule id when NOT_ALLOWED; "timeout", "failed" or "mock" when
  /// NOT_RUN; else null.
  aiWhy           String?
  aiVerdict       ProfilePictureAiVerdict?
  /// Codes from PICTURE_CONCERNS in @orderpilot/shared. Empty unless the AI named some.
  aiConcerns      String[]
  /// The model's note, at most 200 characters. Shown to reviewers as text only.
  aiNote          String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  /// Set only when the upload came from a demo session: that sign-in's family
  /// (AuthContext.sessionId). A PENDING row with it is shown only to that
  /// session and to reviewers. Null for every normal account.
  sessionFamilyId String?                  @db.Uuid
  /// The reviewer who approved or rejected it. No relation: the audit trail
  /// keeps the name, and a disabled reviewer must not block anything.
  decidedById     String?                  @db.Uuid
  decidedAt       DateTime?                @db.Timestamptz(3)
  /// From PICTURE_REJECTION_REASONS (REJECTED) or PICTURE_TAKE_DOWN_REASONS (TAKEN_DOWN).
  reasonCode      String?
  /// The reviewer's note to the owner, at most 140 characters.
  reasonNote      String?
  removedAt       DateTime?                @db.Timestamptz(3)
  /// Who ended it: the owner (WITHDRAWN), the actor of the upload or approval
  /// that replaced it, or the reviewer who took it down.
  removedById     String?                  @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Which role holds which permission. The names come from @orderpilot/shared;
/// area 4 owns the matrix and P-10 seeds the default.
model RolePermission {
  role       Role
  permission String

  @@id([role, permission])
}

/// One append-only audit event. A trigger refuses UPDATE, DELETE and TRUNCATE.
/// Each hash covers the event and the hash before it (see audit.chain.ts).
model AuditEvent {
  /// Gives the chain its order. The database assigns it under the chain lock.
  sequence    BigInt   @unique @default(autoincrement())
  id          String   @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime @db.Timestamptz(3)
  /// "user", "system" or "ai".
  actorKind   String
  actorUserId String?  @db.Uuid
  actorRole   Role?
  /// The system component's name, or the AI model.
  actorLabel  String?
  action      String
  entityType  String
  entityId    String
  summary     String
  /// What changed. Never a secret, a token or a whole document.
  changes     Json?
  ip          String?
  traceId     String
  prevHash    String?
  hash        String   @unique

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([occurredAt])
  // The action filter offers the names that exist (F-9): this index holds them,
  // so the list is read from it, not from every event.
  @@index([action])
}
