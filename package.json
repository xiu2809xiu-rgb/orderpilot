{
  "name": "orderpilot",
  "version": "0.0.0",
  "private": true,
  "description": "AI reads, rules decide, people approve. The OrderPilot workspace.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": ">=12.14.0 <13"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "ai:key": "node scripts/ai-key.mjs",
    "dev": "pnpm --parallel --filter @orderpilot/api --filter @orderpilot/web dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "node --test \"scripts/**/*.test.mjs\" && pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "budget": "pnpm --filter @orderpilot/web budget",
    "e2e": "pnpm --filter @orderpilot/e2e e2e",
    "api:spec": "pnpm --filter @orderpilot/api openapi && prettier --write apps/api/openapi.json",
    "api:generate": "pnpm api:spec && pnpm --filter @orderpilot/web generate:api",
    "api:check": "node scripts/check-api-generated.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:samples": "node scripts/check-samples.mjs",
    "check:samples:history": "node scripts/check-samples.mjs --history",
    "check:licence-key": "node scripts/check-licence-key.mjs",
    "check:codeowners": "node scripts/check-codeowners.mjs",
    "check:secrets": "secretlint --maskSecrets \"**/*\"",
    "db:generate": "pnpm --filter @orderpilot/api db:generate",
    "db:migrate": "pnpm --filter @orderpilot/api db:migrate",
    "db:migrate:dev": "pnpm --filter @orderpilot/api db:migrate:dev",
    "db:seed": "pnpm --filter @orderpilot/api db:seed",
    "docs:generate": "pnpm --filter \"@orderpilot/synthetic-documents...\" run build && pnpm --filter @orderpilot/synthetic-documents generate",
    "stack:up": "docker compose up -d --wait postgres redis minio mailpit",
    "stack:down": "docker compose down",
    "stack:smoke": "node scripts/stack-smoke.mjs",
    "samples:up": "docker compose -f docker-compose.yml -f docker-compose.samples.yml up -d --build --wait",
    "samples:restart-web": "docker compose -f docker-compose.yml -f docker-compose.samples.yml restart web",
    "samples:down": "docker compose -f docker-compose.yml -f docker-compose.samples.yml down --remove-orphans"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@orderpilot/eslint-config": "workspace:*",
    "@orderpilot/tsconfig": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "secretlint": "13.0.7",
    "typescript": "6.0.3"
  }
}
