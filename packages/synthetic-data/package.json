{
  "name": "@orderpilot/synthetic-data",
  "version": "0.0.0",
  "private": true,
  "description": "Synthetic demo data for every screen and test: made-up customers, vendors and orders, items from real brands with made-up part numbers, and 24 months of history.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@orderpilot/shared": "workspace:*"
  },
  "devDependencies": {
    "@orderpilot/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
