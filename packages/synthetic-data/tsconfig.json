{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@orderpilot/tsconfig/base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    // CI type-checks before it builds, so shared has no dist yet. Read its source.
    "paths": {
      "@orderpilot/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "vitest.config.ts"]
}
