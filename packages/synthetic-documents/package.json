{
  "name": "@orderpilot/synthetic-documents",
  "version": "0.0.0",
  "private": true,
  "description": "Real PDFs rendered from the synthetic data, with the position and Mock AI confidence of every field.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "node dist/cli/generate.js"
  },
  "dependencies": {
    "@orderpilot/shared": "workspace:*",
    "@orderpilot/synthetic-data": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@orderpilot/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
